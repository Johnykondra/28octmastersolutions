<%- include("partials/header", { title }) %>
    <main id="main-content" class="account-page">
      <div class="container">
        <div class="account-heading">
          <div>
            <span class="eyebrow eyebrow-dark">YOUR MASTER SOLUTIONS ACCOUNT</span>
            <h1>My Account</h1>
            <p>Welcome, <%= currentUser.name %>.</p>
          </div>
          <a class="btn btn-accent" href="/repairs/new"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Book a repair</a>
        </div>

        <% if (notice) { %>
          <div class="alert alert-<%= notice.type %>" role="status"><%= notice.message %></div>
        <% } %>

        <nav class="account-tabs" aria-label="Account sections">
          <a class="<%= activeTab === "repairs" ? "active" : "" %>" href="/account?tab=repairs" <%= activeTab === "repairs" ? 'aria-current="page"' : "" %>>My Repairs</a>
          <a class="<%= activeTab === "orders" ? "active" : "" %>" href="/account?tab=orders" <%= activeTab === "orders" ? 'aria-current="page"' : "" %>>My Orders</a>
        </nav>

        <% if (activeTab === "repairs") { %>
          <section class="account-panel" aria-labelledby="repairsHeading">
            <div class="account-panel-heading">
              <div>
                <h2 id="repairsHeading">My Repairs</h2>
                <p>Repair requests associated with <%= currentUser.email %>.</p>
              </div>
              <span class="account-count"><%= tickets.length %> <%= tickets.length === 1 ? "ticket" : "tickets" %></span>
            </div>
            <% if (tickets.length) { %>
              <div class="table-responsive">
                <table class="table account-ticket-table align-middle">
                  <thead>
                    <tr>
                      <th scope="col">Ticket number</th>
                      <th scope="col">Device</th>
                      <th scope="col">Service</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% tickets.forEach((ticket) => {
                      const statusClass = ticket.status === "Completed" ? "status-completed"
                        : ticket.status === "Cancelled" ? "status-cancelled"
                        : ticket.status === "Ready for Pickup" ? "status-ready"
                        : ticket.status === "In Progress" ? "status-progress"
                        : ticket.status === "Waiting for Parts" ? "status-waiting"
                        : "status-received";
                    %>
                      <tr>
                        <th scope="row"><%= ticket.ticketNumber %></th>
                        <td><%= ticket.device %></td>
                        <td><%= ticket.service %></td>
                        <td><span class="ticket-status <%= statusClass %>"><%= ticket.status %></span></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="account-empty">
                <span class="account-empty-icon"><i class="bi bi-tools" aria-hidden="true"></i></span>
                <h3>No repair requests yet</h3>
                <p>Your repair tickets will appear here after you book a repair.</p>
                <a class="btn btn-accent" href="/repairs/new">Book a repair</a>
              </div>
            <% } %>
          </section>
        <% } else { %>
          <section class="account-panel" aria-labelledby="ordersHeading">
            <div class="account-panel-heading">
              <div>
                <h2 id="ordersHeading">My Orders</h2>
                <p>Orders associated with <%= currentUser.email %>.</p>
              </div>
              <span class="account-count"><%= orders.length %> <%= orders.length === 1 ? "order" : "orders" %></span>
            </div>
            <% if (orders.length) { %>
              <div class="table-responsive">
                <table class="table account-ticket-table align-middle">
                  <thead>
                    <tr>
                      <th scope="col">Order</th>
                      <th scope="col">Placed</th>
                      <th scope="col">Items</th>
                      <th scope="col">Delivery</th>
                      <th scope="col">Total</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% orders.forEach((order) => { %>
                      <tr>
                        <th scope="row"><%= order.orderNumber %></th>
                        <td><%= new Date(`${order.createdAt.replace(" ", "T")}Z`).toLocaleDateString("en-AE", { dateStyle: "medium", timeZone: "Asia/Dubai" }) %></td>
                        <td>
                          <ul class="order-item-list">
                            <% order.items.forEach((item) => { %>
                              <li><%= item.productName %> × <%= item.quantity %></li>
                            <% }); %>
                          </ul>
                        </td>
                        <td><%= order.deliveryMethod === "pickup" ? "Pick up in store" : `Delivery within Fujairah` %></td>
                        <td><%= formatPrice(order.totalFils) %></td>
                        <td><span class="ticket-status <%= order.status === "Paid" ? "status-paid" : "status-pending" %>"><%= order.status %></span></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="account-empty">
                <span class="account-empty-icon"><i class="bi bi-bag" aria-hidden="true"></i></span>
                <h3>No orders yet</h3>
                <p>Your orders will appear here after checkout.</p>
                <a class="btn btn-outline-primary" href="/shop">Browse the shop</a>
              </div>
            <% } %>
          </section>
        <% } %>
      </div>
    </main>
<%- include("partials/footer") %>
